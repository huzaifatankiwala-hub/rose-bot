# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Optional Telegram BotFather token to enable live Telegram polling/webhook bridge.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_URL: Optional public HTTPS base URL for 24/7 serverless Webhook mode (e.g. Cloud Run / Render / Railway).
# Leave empty to use built-in Long Polling mode.
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# Optional Owner MTProto Override (allows /demote & /promote on old Owner-promoted admins):
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
OWNER_SESSION_STRING=""

# DB_PATH: SQLite database file path for persistent group members, warnings, and messages.
DB_PATH="bot_data.db"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

